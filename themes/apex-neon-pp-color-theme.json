    // ── Semantic Token Colors ───────────────────────────────────
    // Maximum C# differentiation (++) — Dracula-inspired neon palette
    "semanticTokenColors": {
        // ── Types — Maximum differentiation: every category distinct ──
        "type": "#8be9fd",
        "class": "#8be9fd",
        "struct": "#69ff94",
        "interface": "#caa0f5",
        "enum": "#ff6e6e",
        "typeParameter": "#a4ffff",
        // ── Namespace — muted, navigational not semantic ──
        "namespace": "#7a7fb5",
        // ── Functions / Methods — neon green (unmistakable) ──
        "function": "#50fa7b",
        "method": "#50fa7b",
        "function.declaration": "#50fa7b",
        "method.declaration": "#50fa7b",
        // ── Properties / Fields — bright orange, distinct from variables ──
        "property": "#ffb86c",
        "property.static": {
            "foreground": "#ffb86c",
            "fontStyle": "italic"
        },
        // ── Variables — bright near-white for maximum clarity ──
