        "newOperator": "#ff79c6",
        // ── Strings / Numbers ──
        "string": "#f1fa8c",
        "stringLiteral": "#f1fa8c",
        "number": "#bd93f9",
        "numberLiteral": "#bd93f9",
        // ── Other ──
