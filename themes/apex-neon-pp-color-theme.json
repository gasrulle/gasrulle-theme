    "tokenColors": [
        // ── General ─────────────────────────────────────────────
        {
            "scope": [
                "source",
                "text"
            ],
            "settings": {
                "foreground": "#C2C2CA"
            }
        },
        // ── Comments ────────────────────────────────────────────
        // Dracula blue-gray — stays quiet while neon syntax blazes
        {
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#566698",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "comment.block.documentation",
                "comment.block.javadoc"
            ],
            "settings": {
                "foreground": "#4E5688",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "comment.block.documentation keyword",
                "comment.block.documentation storage.type",
                "entity.name.type.instance.jsdoc",
                "keyword.other.documentation",
                "storage.type.class.jsdoc"
            ],
            "settings": {
                "foreground": "#8C7C94"
            }
        },
        // ── Keywords / Control ──────────────────────────────────
        // Hot pink — electric and unmistakable, Dracula's signature
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.delete",
                "keyword.operator.expression",
                "keyword.operator.instanceof",
                "keyword.operator.new",
                "keyword.operator.typeof",
                "keyword.operator.void",
                "storage",
                "storage.modifier",
                "storage.type"
            ],
            "settings": {
                "foreground": "#ff79c6"
            }
        },
        // ── Control Flow — brighter pink + italic ───────────────
        {
            "scope": [
                "keyword.control.conditional",
                "keyword.control.flow",
                "keyword.control.loop",
                "keyword.control.trycatch"
            ],
            "settings": {
                "foreground": "#ff92d0",
                "fontStyle": "italic"
            }
        },
        // ── Operators ───────────────────────────────────────────
        {
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.assignment",
                "keyword.operator.bitwise",
                "keyword.operator.comparison",
                "keyword.operator.decrement",
                "keyword.operator.increment",
                "keyword.operator.relational",
                "keyword.operator.ternary",
                "punctuation.accessor",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": {
                "foreground": "#9090c0"
            }
        },
        // ── Logical / Bitwise operators — electric cyan ─────────
        {
            "scope": [
                "keyword.operator.logical",
                "keyword.operator.logical.python"
            ],
            "settings": {
                "foreground": "#8be9fd"
            }
        },
        // ── Strings ─────────────────────────────────────────────
        // Electric yellow-green — vibrant and eye-catching
        {
            "scope": [
                "string",
                "string.interpolated",
                "string.quoted",
                "string.template"
            ],
            "settings": {
                "foreground": "#f1fa8c"
            }
        },
        {
            "scope": [
                "constant.character.escape",
                "string.template punctuation.definition.template-expression"
            ],
            "settings": {
                "foreground": "#ffb86c"
            }
        },
        // ── Numbers ─────────────────────────────────────────────
        // Vivid purple — saturated and distinct
        {
            "scope": [
                "constant.numeric",
                "constant.numeric.binary",
                "constant.numeric.float",
                "constant.numeric.hex",
                "constant.numeric.integer",
                "constant.numeric.octal"
            ],
            "settings": {
                "foreground": "#bd93f9"
            }
        },
        // ── Constants ───────────────────────────────────────────
        {
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined",
                "support.constant",
                "variable.language.self",
                "variable.language.super",
                "variable.language.this"
            ],
            "settings": {
                "foreground": "#bd93f9",
                "fontStyle": "italic"
            }
        },
        // ── Functions ───────────────────────────────────────────
        // Neon green — Dracula's showstopper, impossible to miss
        {
            "scope": [
                "entity.name.function",
                "meta.function-call entity.name.function",
                "meta.method-call entity.name.function",
                "support.function"
            ],
            "settings": {
                "foreground": "#50fa7b"
            }
        },
        {
            "scope": [
                "entity.name.function.member",
                "meta.function-call support.function"
            ],
            "settings": {
                "foreground": "#50fa7b"
            }
        },
        // ── Classes / Types ─────────────────────────────────────
        // Electric cyan — bright and futuristic
        {
            "scope": [
                "entity.name.type",
                "entity.name.type.class",
                "entity.name.type.enum",
                "entity.name.type.interface",
                "entity.name.type.struct",
                "entity.other.inherited-class",
                "support.class",
                "support.type"
            ],
            "settings": {
                "foreground": "#8be9fd"
            }
        },
        // ── Type Parameters ─────────────────────────────────────
        // Bright aqua — even brighter than types
        {
            "scope": [
                "entity.name.type.parameter",
                "entity.name.type.type-parameter"
            ],
            "settings": {
                "foreground": "#a4ffff"
            }
        },
        // ── Variables / Parameters ───────────────────────────────
        // Bright near-white — maximum clarity for data
        {
            "scope": [
                "meta.parameter",
                "variable",
                "variable.other",
                "variable.parameter"
            ],
            "settings": {
                "foreground": "#C2C2CA"
            }
        },
        // ── Properties / Fields ─────────────────────────────────
        // Bright orange — energetic and warm against neon cool
        {
            "scope": [
                "entity.name.tag.yaml",
                "meta.object-literal.key",
                "support.type.property-name",
                "variable.other.object.property",
                "variable.other.property"
            ],
            "settings": {
                "foreground": "#ffb86c"
            }
        },
        // ── Constants (all caps / enums) ────────────────────────
        {
            "scope": [
                "variable.other.constant",
                "variable.other.enummember"
            ],
            "settings": {
                "foreground": "#bd93f9",
                "fontStyle": "italic"
            }
        },
        // ── Annotations / Decorators ────────────────────────────
        // Golden — warm metadata accent
        {
            "scope": [
                "meta.attribute",
                "meta.decorator",
                "meta.decorator entity.name.function",
                "meta.decorator punctuation.decorator",
                "punctuation.definition.annotation",
                "storage.type.annotation"
            ],
            "settings": {
                "foreground": "#ffd580"
            }
        },
        // ── Namespace / Module ──────────────────────────────────
        {
            "scope": [
                "entity.name.module",
                "entity.name.namespace",
                "entity.name.type.module",
                "entity.name.type.namespace"
            ],
            "settings": {
                "foreground": "#7a7fb5"
            }
        },
        // ── Punctuation ─────────────────────────────────────────
        {
            "scope": [
                "meta.brace",
                "punctuation.bracket",
                "punctuation.definition.arguments",
                "punctuation.definition.block",
                "punctuation.definition.parameters",
                "punctuation.section"
            ],
            "settings": {
                "foreground": "#9090c0"
            }
        },
        // ── HTML / XML Tags ─────────────────────────────────────
        // Neon coral-red — vivid and distinct from pink keywords
        {
            "scope": [
                "entity.name.tag",
                "punctuation.definition.tag"
            ],
            "settings": {
                "foreground": "#ff6e6e"
            }
        },
        {
            "scope": [
                "entity.name.tag.custom",
                "entity.name.tag.other.custom",
                "support.class.component"
            ],
            "settings": {
                "foreground": "#8be9fd"
            }
        },
        // ── HTML / XML Attributes ───────────────────────────────
        {
            "scope": [
                "entity.other.attribute-name"
            ],
            "settings": {
                "foreground": "#ffd580"
            }
        },
