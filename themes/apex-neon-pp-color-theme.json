            "foreground": "#C2C2CA",
            "fontStyle": "italic"
        },
        "variable.static": {
            "foreground": "#C2C2CA",
            "fontStyle": "italic"
        },
        // ── Parameters — warm golden, distinct from variables ──
        "parameter": "#ffd580",
        // ── Enum Members — number color italic (constant-like) ──
        "enumMember": {
            "foreground": "#bd93f9",
            "fontStyle": "italic"
        },
        // ── Events — electric cyan, distinct from properties ──
        "event": "#8be9fd",
        // ── Keywords — hot pink ──
        "keyword": "#ff79c6",
        "keyword.controlFlow": {
            "foreground": "#ff92d0",
            "fontStyle": "italic"
        },
        // ── Operators ──
