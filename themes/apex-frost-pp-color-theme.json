    "tokenColors": [
        // ── General ─────────────────────────────────────────────
        {
            "scope": [
                "source",
                "text"
            ],
            "settings": {
                "foreground": "#B0B4C4"
            }
        },
        // ── Comments ────────────────────────────────────────────
        // Cool blue-gray — Tokyo Night storm territory
        // Comments stay quiet while functional code commands attention
        {
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#586390",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "comment.block.documentation",
                "comment.block.javadoc"
            ],
            "settings": {
                "foreground": "#4d577a",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "comment.block.documentation keyword",
                "comment.block.documentation storage.type",
                "entity.name.type.instance.jsdoc",
                "keyword.other.documentation",
                "storage.type.class.jsdoc"
            ],
            "settings": {
                "foreground": "#6E8098"
            }
        },
        // ── Keywords / Control ──────────────────────────────────
        // Azure blue — cool and clean, inspired by Tokyo Night Storm
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.delete",
                "keyword.operator.expression",
                "keyword.operator.instanceof",
                "keyword.operator.new",
                "keyword.operator.typeof",
                "keyword.operator.void",
                "storage",
                "storage.modifier",
                "storage.type"
            ],
            "settings": {
                "foreground": "#7aa2f7"
            }
        },
        // ── Control Flow — slightly brighter + italic ───────────
        {
            "scope": [
                "keyword.control.conditional",
                "keyword.control.flow",
                "keyword.control.loop",
                "keyword.control.trycatch"
            ],
            "settings": {
                "foreground": "#89b4fa",
                "fontStyle": "italic"
            }
        },
        // ── Operators ───────────────────────────────────────────
        {
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.assignment",
                "keyword.operator.bitwise",
                "keyword.operator.comparison",
                "keyword.operator.decrement",
                "keyword.operator.increment",
                "keyword.operator.relational",
                "keyword.operator.ternary",
                "punctuation.accessor",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": {
                "foreground": "#808498"
            }
        },
        // ── Logical / Bitwise operators — slightly brighter ─────
        {
            "scope": [
                "keyword.operator.logical",
                "keyword.operator.logical.python"
            ],
            "settings": {
                "foreground": "#2ac3de"
            }
        },
        // ── Strings ─────────────────────────────────────────────
        // Cool green — clean and readable against blue-tinted backgrounds
        {
            "scope": [
                "string",
                "string.interpolated",
                "string.quoted",
                "string.template"
            ],
            "settings": {
                "foreground": "#9ece6a"
            }
        },
        {
            "scope": [
                "constant.character.escape",
                "string.template punctuation.definition.template-expression"
            ],
            "settings": {
                "foreground": "#E8B48A"
            }
        },
        // ── Numbers ─────────────────────────────────────────────
        // Warm orange — provides warm contrast pop in the cool palette
        {
            "scope": [
                "constant.numeric",
                "constant.numeric.binary",
                "constant.numeric.float",
                "constant.numeric.hex",
                "constant.numeric.integer",
                "constant.numeric.octal"
            ],
            "settings": {
                "foreground": "#E8B48A"
            }
        },
        // ── Constants ───────────────────────────────────────────
        {
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined",
                "support.constant",
                "variable.language.self",
                "variable.language.super",
                "variable.language.this"
            ],
            "settings": {
                "foreground": "#E8B48A",
                "fontStyle": "italic"
            }
        },
        // ── Functions ───────────────────────────────────────────
        // Cool cyan — Tokyo Night's signature color for high visibility
        {
            "scope": [
                "entity.name.function",
                "meta.function-call entity.name.function",
                "meta.method-call entity.name.function",
                "support.function"
            ],
            "settings": {
                "foreground": "#7dcfff"
            }
        },
        {
            "scope": [
                "entity.name.function.member",
                "meta.function-call support.function"
            ],
            "settings": {
                "foreground": "#7dcfff"
            }
        },
        // ── Classes / Types ─────────────────────────────────────
        // Aqua — cool and distinctive, clear type identification
        {
            "scope": [
                "entity.name.type",
                "entity.name.type.class",
                "entity.name.type.enum",
                "entity.name.type.interface",
                "entity.name.type.struct",
                "entity.other.inherited-class",
                "support.class",
                "support.type"
            ],
            "settings": {
                "foreground": "#2ac3de"
            }
        },
        // ── Type Parameters ─────────────────────────────────────
        // Light aqua — lighter than types, cooler than functions
        {
            "scope": [
                "entity.name.type.parameter",
                "entity.name.type.type-parameter"
            ],
            "settings": {
                "foreground": "#b4f9f8"
            }
        },
        // ── Variables / Parameters ───────────────────────────────
        // Neutral near-white for state/data — clean and readable
        {
            "scope": [
                "meta.parameter",
                "variable",
                "variable.other",
                "variable.parameter"
            ],
            "settings": {
                "foreground": "#C4C8D6"
            }
        },
        // ── Properties / Fields ─────────────────────────────────
        // Teal-green — distinct from variables, cool and functional
        {
            "scope": [
                "entity.name.tag.yaml",
                "meta.object-literal.key",
                "support.type.property-name",
                "variable.other.object.property",
                "variable.other.property"
            ],
            "settings": {
                "foreground": "#73daca"
            }
        },
        // ── Constants (all caps / enums) ────────────────────────
        {
            "scope": [
                "variable.other.constant",
                "variable.other.enummember"
            ],
            "settings": {
                "foreground": "#E8B48A",
                "fontStyle": "italic"
            }
        },
        // ── Annotations / Decorators ────────────────────────────
        // Amber — warm accent for metadata
        {
            "scope": [
                "meta.attribute",
                "meta.decorator",
                "meta.decorator entity.name.function",
                "meta.decorator punctuation.decorator",
                "punctuation.definition.annotation",
                "storage.type.annotation"
            ],
            "settings": {
                "foreground": "#BAA478"
            }
        },
        // ── Namespace / Module ──────────────────────────────────
        {
            "scope": [
                "entity.name.module",
                "entity.name.namespace",
                "entity.name.type.module",
                "entity.name.type.namespace"
            ],
            "settings": {
                "foreground": "#767daa"
            }
        },
        // ── Punctuation ─────────────────────────────────────────
        {
            "scope": [
                "meta.brace",
                "punctuation.bracket",
                "punctuation.definition.arguments",
                "punctuation.definition.block",
                "punctuation.definition.parameters",
                "punctuation.section"
            ],
            "settings": {
                "foreground": "#808498"
            }
        },
        // ── HTML / XML Tags ─────────────────────────────────────
        // Rose — distinct and visible against cool backgrounds
        {
            "scope": [
                "entity.name.tag",
                "punctuation.definition.tag"
            ],
            "settings": {
                "foreground": "#f7768e"
            }
        },
        {
            "scope": [
                "entity.name.tag.custom",
                "entity.name.tag.other.custom",
                "support.class.component"
            ],
            "settings": {
