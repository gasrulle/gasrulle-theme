    // ── Semantic Token Colors ───────────────────────────────────
    // Maximum C# differentiation (++) — Tokyo Night cool palette
    "semanticTokenColors": {
        // ── Types — Maximum differentiation: every category distinct ──
        "type": "#2ac3de",
        "class": "#2ac3de",
        "struct": "#8BD4A0",
        "interface": "#bb9af7",
        "enum": "#f7768e",
        "typeParameter": "#b4f9f8",
        // ── Namespace — muted, navigational not semantic ──
        "namespace": "#767daa",
        // ── Functions / Methods — cool cyan (high visibility) ──
        "function": "#7dcfff",
        "method": "#7dcfff",
        "function.declaration": "#7dcfff",
        "method.declaration": "#7dcfff",
        // ── Properties / Fields — teal, distinct from variables ──
        "property": "#73daca",
        "property.static": {
            "foreground": "#73daca",
            "fontStyle": "italic"
        },
        // ── Variables — neutral near-white for state/data ──
        "variable": "#C4C8D6",
        "variable.readonly": {
            "foreground": "#C4C8D6",
            "fontStyle": "italic"
        },
        "variable.static": {
            "foreground": "#C4C8D6",
            "fontStyle": "italic"
        },
        // ── Parameters — warm amber, distinct from variables ──
        "parameter": "#BAA478",
        // ── Enum Members — number color italic (constant-like) ──
        "enumMember": {
            "foreground": "#E8B48A",
            "fontStyle": "italic"
        },
        // ── Events — aqua, distinct from properties ──
        "event": "#2ac3de",
        // ── Keywords — azure blue ──
        "keyword": "#7aa2f7",
        "keyword.controlFlow": {
            "foreground": "#89b4fa",
            "fontStyle": "italic"
        },
        // ── C# custom: Roslyn emits controlKeyword as a separate token type ──
        "controlKeyword": {
            "foreground": "#89b4fa",
            "fontStyle": "italic"
        },
        // ── Operators ──
        "operator": "#808498",
        "newOperator": "#7aa2f7",
        // ── C# custom: overloaded operators use function color ──
        "operatorOverloaded": "#7dcfff",
        // ── Strings / Numbers ──
        "string": "#9ece6a",
        "stringLiteral": "#9ece6a",
        // ── C# custom: verbatim strings ──
        "stringVerbatim": "#9ece6a",
        // ── C# custom: escape characters — keyword color ──
        "stringEscapeCharacter": "#7aa2f7",
        "number": "#E8B48A",
        "numberLiteral": "#E8B48A",
        // ── Other ──
        "regexp": "#f7768e",
        "decorator": "#BAA478",
        "customLiteral": "#E8B48A",
        "macro": "#BAA478",
        "label": "#808498",
        // ── C# custom: preprocessor ──
        "preprocessorKeyword": "#7aa2f7",
        "preprocessorText": "#B0B4C4",
        // ── C# custom: excluded/disabled code ──
        "excludedCode": "#808080",
        // ── C# custom: punctuation ──
        "punctuation": "#808498",
        // ── C# custom: delegate, extension method, record types ──
        "delegate": "#2ac3de",
        "extensionMethod": "#7dcfff",
        "recordClass": "#2ac3de",
        "recordStruct": "#8BD4A0",
        "plainKeyword": "#7aa2f7",
        "field": "#73daca",
        "local": "#C4C8D6",
        // ── C# XML Doc Comments (custom semantic tokens from Roslyn) ──
        "xmlDocCommentText": {
            "foreground": "#4d577a",
            "fontStyle": "italic"
        },
        "xmlDocCommentDelimiter": "#4d577a",
        "xmlDocCommentName": "#6E8098",
        "xmlDocCommentAttributeName": "#6E8098",
        "xmlDocCommentAttributeQuotes": "#4d577a",
        "xmlDocCommentAttributeValue": "#6E8098",
        "xmlDocCommentCDataSection": {
            "foreground": "#4d577a",
            "fontStyle": "italic"
        },
        "xmlDocCommentEntityReference": "#6E8098",
        "xmlDocCommentProcessingInstruction": "#6E8098",
        "xmlDocCommentComment": "#586390",
        // ── Static modifiers — italic signals static ──
        "function.static": {
            "foreground": "#7dcfff",
            "fontStyle": "italic"
        },
        "method.static": {
            "foreground": "#7dcfff",
            "fontStyle": "italic"
        }
    }
}
