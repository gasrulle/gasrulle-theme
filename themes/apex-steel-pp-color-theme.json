    // ── Semantic Token Colors ───────────────────────────────────
    // Maximum C# differentiation (++) — One Dark Pro balanced palette
    "semanticTokenColors": {
        // ── Types — Maximum differentiation: every category distinct ──
        "type": "#56b6c2",
        "class": "#56b6c2",
        "struct": "#73c990",
        "interface": "#c8a2d6",
        "enum": "#e5a6a6",
        "typeParameter": "#7ee0cf",
        // ── Namespace — muted, navigational not semantic ──
        "namespace": "#7a818e",
        // ── Functions / Methods — clear blue (balanced readability) ──
        "function": "#61afef",
        "method": "#61afef",
        "function.declaration": "#61afef",
        "method.declaration": "#61afef",
        // ── Properties / Fields — red-rose, distinct from variables ──
        "property": "#e06c75",
        "property.static": {
            "foreground": "#e06c75",
            "fontStyle": "italic"
        },
        // ── Variables — neutral foreground for state/data ──
        "variable": "#abb2bf",
        "variable.readonly": {
            "foreground": "#abb2bf",
            "fontStyle": "italic"
        },
        "variable.static": {
            "foreground": "#abb2bf",
            "fontStyle": "italic"
        },
        // ── Parameters — golden yellow, distinct from variables ──
        "parameter": "#e5c07b",
        // ── Enum Members — number color italic (constant-like) ──
        "enumMember": {
            "foreground": "#d19a66",
            "fontStyle": "italic"
        },
        // ── Events — cyan-teal, distinct from properties ──
        "event": "#56b6c2",
        // ── Keywords — purple ──
        "keyword": "#c678dd",
        "keyword.controlFlow": {
            "foreground": "#d183e8",
            "fontStyle": "italic"
        },
        // ── C# custom: Roslyn emits controlKeyword as a separate token type ──
        "controlKeyword": {
            "foreground": "#d183e8",
            "fontStyle": "italic"
        },
        // ── Operators ──
        "operator": "#828997",
        "newOperator": "#c678dd",
        // ── C# custom: overloaded operators use function color ──
        "operatorOverloaded": "#61afef",
        // ── Strings / Numbers ──
        "string": "#98c379",
        "stringLiteral": "#98c379",
        // ── C# custom: verbatim strings ──
        "stringVerbatim": "#98c379",
        // ── C# custom: escape characters — keyword color ──
        "stringEscapeCharacter": "#c678dd",
        "number": "#d19a66",
        "numberLiteral": "#d19a66",
        // ── Other ──
        "regexp": "#e06c75",
        "decorator": "#e5c07b",
        "customLiteral": "#d19a66",
        "macro": "#e5c07b",
        "label": "#828997",
        // ── C# custom: preprocessor ──
        "preprocessorKeyword": "#c678dd",
        "preprocessorText": "#ABB2BF",
        // ── C# custom: excluded/disabled code ──
        "excludedCode": "#808080",
        // ── C# custom: punctuation ──
        "punctuation": "#828997",
        // ── C# custom: delegate, extension method, record types ──
        "delegate": "#56b6c2",
        "extensionMethod": "#61afef",
        "recordClass": "#56b6c2",
        "recordStruct": "#73c990",
        "plainKeyword": "#c678dd",
        "field": "#e06c75",
        "local": "#ABB2BF",
        // ── C# XML Doc Comments (custom semantic tokens from Roslyn) ──
        "xmlDocCommentText": {
            "foreground": "#515662",
            "fontStyle": "italic"
        },
        "xmlDocCommentDelimiter": "#515662",
        "xmlDocCommentName": "#8E7E6E",
        "xmlDocCommentAttributeName": "#8E7E6E",
        "xmlDocCommentAttributeQuotes": "#515662",
        "xmlDocCommentAttributeValue": "#8E7E6E",
        "xmlDocCommentCDataSection": {
            "foreground": "#515662",
            "fontStyle": "italic"
        },
        "xmlDocCommentEntityReference": "#8E7E6E",
        "xmlDocCommentProcessingInstruction": "#8E7E6E",
        "xmlDocCommentComment": "#5B6270",
        // ── Static modifiers — italic signals static ──
        "function.static": {
            "foreground": "#61afef",
            "fontStyle": "italic"
        },
        "method.static": {
            "foreground": "#61afef",
            "fontStyle": "italic"
        }
    }
