    // ── Semantic Token Colors ───────────────────────────────────
    // Maximum C# differentiation (++) — every type category & modifier unique
    // Carbon palette: vivid syntax against pure gray backgrounds
    // Hue distribution: every 30–50° of color wheel for perfect neutrality
    "semanticTokenColors": {
        // ── Types — Maximum differentiation: every category distinct ──
        "type": "#58B8B8",
        "class": "#58B8B8",
        "struct": "#68C490",
        "interface": "#A888C8",
        "enum": "#C48088",
        "typeParameter": "#68C8C8",
        // ── Namespace — muted gray, navigational not semantic ──
        "namespace": "#989898",
        // ── Functions / Methods — steel blue (measured clarity) ──
        "function": "#68B8E4",
        "method": "#68B8E4",
        "function.declaration": "#68B8E4",
        "method.declaration": "#68B8E4",
        // ── Properties / Fields — salmon, distinct from variables ──
        "property": "#C88878",
        "property.static": {
            "foreground": "#C88878",
            "fontStyle": "italic"
        },
        // ── Variables — pure silver, achromatic baseline ──
