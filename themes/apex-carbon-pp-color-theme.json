    "tokenColors": [
        // ── General ─────────────────────────────────────────────
        {
            "scope": [
                "source",
                "text"
            ],
            "settings": {
                "foreground": "#d8d8d8"
            }
        },
        // ── Comments ────────────────────────────────────────────
        // Pure achromatic gray — no tint, no warmth, just quiet
        {
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#7a7a7a",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "comment.block.documentation",
                "comment.block.javadoc"
            ],
            "settings": {
                "foreground": "#686868",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "comment.block.documentation keyword",
                "comment.block.documentation storage.type",
                "entity.name.type.instance.jsdoc",
                "keyword.other.documentation",
                "storage.type.class.jsdoc"
            ],
            "settings": {
                "foreground": "#A09890"
            }
        },
        // ── Keywords / Control ──────────────────────────────────
        // Rose — vivid against achromatic background
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.delete",
                "keyword.operator.expression",
                "keyword.operator.instanceof",
                "keyword.operator.new",
                "keyword.operator.typeof",
                "keyword.operator.void",
                "storage",
                "storage.modifier",
                "storage.type"
            ],
            "settings": {
                "foreground": "#D8809A"
            }
        },
        // ── Control Flow — slightly brighter + italic ───────────
        // Brighter dusty rose for structural flow control
        {
            "scope": [
                "keyword.control.conditional",
                "keyword.control.flow",
                "keyword.control.loop",
                "keyword.control.trycatch"
            ],
            "settings": {
                "foreground": "#E090AA",
                "fontStyle": "italic"
            }
        },
        // ── Operators ───────────────────────────────────────────
        {
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.assignment",
                "keyword.operator.bitwise",
                "keyword.operator.comparison",
                "keyword.operator.decrement",
                "keyword.operator.increment",
                "keyword.operator.relational",
                "keyword.operator.ternary",
                "punctuation.accessor",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": {
                "foreground": "#a0a0a0"
            }
        },
        // ── Logical / Bitwise operators — turquoise accent ──────
        {
            "scope": [
                "keyword.operator.logical",
                "keyword.operator.logical.python"
            ],
            "settings": {
                "foreground": "#58B8B8"
            }
        },
        // ── Strings ─────────────────────────────────────────────
        // Sage green — vivid, clean
        {
            "scope": [
                "string",
                "string.interpolated",
                "string.quoted",
                "string.template"
            ],
            "settings": {
                "foreground": "#8CC47C"
            }
        },
        {
            "scope": [
                "constant.character.escape",
                "string.template punctuation.definition.template-expression"
            ],
            "settings": {
                "foreground": "#C8A078"
            }
        },
        // ── Numbers ─────────────────────────────────────────────
        // Desaturated sand — cooled from amber, reduced yellow cast
        {
            "scope": [
                "constant.numeric",
                "constant.numeric.binary",
                "constant.numeric.float",
                "constant.numeric.hex",
                "constant.numeric.integer",
                "constant.numeric.octal"
            ],
            "settings": {
                "foreground": "#C8A078"
            }
        },
        // ── Constants ───────────────────────────────────────────
        // Sand italic — constants share the desaturated numeric warmth
        {
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined",
                "support.constant",
                "variable.language.self",
                "variable.language.super",
                "variable.language.this"
            ],
            "settings": {
                "foreground": "#C8A078",
                "fontStyle": "italic"
            }
        },
        // ── Functions ───────────────────────────────────────────
        // Rich steel blue — vivid clarity
        {
            "scope": [
                "entity.name.function",
                "meta.function-call entity.name.function",
                "meta.method-call entity.name.function",
                "support.function"
            ],
            "settings": {
                "foreground": "#68B8E4"
            }
        },
        {
            "scope": [
                "entity.name.function.member",
                "meta.function-call support.function"
            ],
            "settings": {
                "foreground": "#68B8E4"
            }
        },
        // ── Classes / Types ─────────────────────────────────────
        // Vivid turquoise — distinct type color
        {
            "scope": [
                "entity.name.type",
                "entity.name.type.class",
                "entity.name.type.enum",
                "entity.name.type.interface",
                "entity.name.type.struct",
                "entity.other.inherited-class",
                "support.class",
                "support.type"
            ],
            "settings": {
                "foreground": "#58B8B8"
            }
        },
        // ── Type Parameters ─────────────────────────────────────
        // Lighter turquoise — distinct from class turquoise
        {
            "scope": [
                "entity.name.type.parameter",
                "entity.name.type.type-parameter"
            ],
            "settings": {
                "foreground": "#68C8C8"
            }
        },
        // ── Variables / Parameters ───────────────────────────────
        // Pure silver foreground — achromatic variable baseline
        {
            "scope": [
                "meta.parameter",
                "variable",
                "variable.other",
                "variable.parameter"
            ],
            "settings": {
                "foreground": "#d8d8d8"
            }
        },
        // ── Properties / Fields ─────────────────────────────────
        // Salmon — warm property color, distinct from variables
        {
            "scope": [
                "entity.name.tag.yaml",
                "meta.object-literal.key",
                "support.type.property-name",
                "variable.other.object.property",
                "variable.other.property"
            ],
            "settings": {
                "foreground": "#C88878"
            }
        },
        // ── Constants (all caps / enums) ────────────────────────
        {
            "scope": [
                "variable.other.constant",
                "variable.other.enummember"
            ],
            "settings": {
                "foreground": "#C8A078",
                "fontStyle": "italic"
            }
        },
        // ── Annotations / Decorators ────────────────────────────
        // Eucalyptus sage — cooled metadata, distinct from sand numbers
        {
            "scope": [
                "meta.attribute",
                "meta.decorator",
                "meta.decorator entity.name.function",
                "meta.decorator punctuation.decorator",
                "punctuation.definition.annotation",
                "storage.type.annotation"
            ],
            "settings": {
                "foreground": "#98B880"
            }
        },
        // ── Namespace / Module ──────────────────────────────────
        // Muted gray — navigational, not semantic
        {
            "scope": [
                "entity.name.module",
                "entity.name.namespace",
                "entity.name.type.module",
                "entity.name.type.namespace"
            ],
            "settings": {
                "foreground": "#989898"
            }
        },
        // ── Punctuation ─────────────────────────────────────────
        {
            "scope": [
                "meta.brace",
                "punctuation.bracket",
                "punctuation.definition.arguments",
                "punctuation.definition.block",
                "punctuation.definition.parameters",
                "punctuation.section"
            ],
            "settings": {
                "foreground": "#a0a0a0"
            }
        },
        // ── HTML / XML Tags ─────────────────────────────────────
        // Dusty red — distinct from keyword rose, measured
        {
            "scope": [
                "entity.name.tag",
                "punctuation.definition.tag"
            ],
            "settings": {
                "foreground": "#C07070"
            }
        },
        {
            "scope": [
                "entity.name.tag.custom",
                "entity.name.tag.other.custom",
                "support.class.component"
            ],
