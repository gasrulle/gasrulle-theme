        "variable.readonly": {
            "foreground": "#d8d8d8",
            "fontStyle": "italic"
        },
        "variable.static": {
            "foreground": "#d8d8d8",
            "fontStyle": "italic"
        },
        // ── Parameters — eucalyptus sage, distinct from variables ──
        "parameter": "#98B880",
        // ── Enum Members — number color italic (constant-like) ──
        "enumMember": {
            "foreground": "#C8A078",
            "fontStyle": "italic"
        },
        // ── Events — turquoise, distinct from properties ──
        "event": "#58B8B8",
        // ── Keywords — dusty rose ──
        "keyword": "#D8809A",
        "keyword.controlFlow": {
            "foreground": "#E090AA",
            "fontStyle": "italic"
        },
        // ── Operators ──
        "operator": "#a0a0a0",
        "newOperator": "#D8809A",
        // ── Strings / Numbers ──
        "string": "#8CC47C",
        "stringLiteral": "#8CC47C",
        "number": "#C8A078",
        "numberLiteral": "#C8A078",
        // ── Other ──
        "regexp": "#C07070",
        "decorator": "#98B880",
        "customLiteral": "#C8A078",
        "macro": "#98B880",
        "label": "#a0a0a0",
