    "tokenColors": [
        // ── General ─────────────────────────────────────────────
        {
            "scope": [
                "meta.embedded",
                "source.groovy.embedded",
                "string meta.image.inline.markdown",
                "variable.legacy.builtin.python"
            ],
            "settings": {
                "foreground": "#D4D4D4"
            }
        },
        // ── Comments (standard VS IDE green #57A64A) ──────────
        {
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#57A64A"
            }
        },
        // ── XML Doc Comments ────────────────────────────────────
        // Green — sourced from Roslyn VisualStudio2019.xml (xml doc comment - text: #608B4E)
        {
            "scope": [
                "comment.block.documentation",
                "comment.block.javadoc"
            ],
            "settings": {
                "foreground": "#608B4E",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "comment.block.documentation keyword",
                "comment.block.documentation storage.type",
                "keyword.other.documentation",
                "storage.type.class.jsdoc",
                "entity.name.type.instance.jsdoc"
            ],
            "settings": {
                "foreground": "#C8C8C8"
            }
        },
        // ── Keywords / Control ──────────────────────────────────
        {
            "scope": [
                "keyword",
                "keyword.operator.new",
                "keyword.operator.expression",
                "keyword.operator.delete",
                "keyword.operator.typeof",
                "keyword.operator.void",
                "keyword.operator.sizeof",
                "keyword.operator.instanceof",
                "storage",
                "storage.type",
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#569CD6"
            }
        },
        // ── Control Flow Keywords (return, if, else, for, await, etc.) ─
        {
            "scope": [
                "keyword.control",
                "keyword.control.flow",
                "keyword.control.loop",
                "keyword.control.conditional",
                "keyword.control.trycatch",
                "keyword.operator.expression.await.cs",
                "keyword.operator.expression.yield.cs"
            ],
            "settings": {
                "foreground": "#D8A0DF"
            }
        },
        // ── Using keyword override (blue, not purple) ──────────
        {
            "scope": [
                "keyword.other.using.cs",
                "keyword.other.directive.using",
                "keyword.other.using"
            ],
            "settings": {
                "foreground": "#569CD6"
            }
        },
        // ── Operators ───────────────────────────────────────────
        {
            "scope": [
                "keyword.operator",
                "keyword.operator.assignment",
                "keyword.operator.arithmetic",
                "keyword.operator.comparison",
                "keyword.operator.relational",
                "keyword.operator.bitwise",
                "keyword.operator.increment",
                "keyword.operator.decrement",
                "keyword.operator.ternary",
                "keyword.operator.logical.python"
            ],
            "settings": {
                "foreground": "#B4B4B4"
            }
        },
        // ── Punctuation ─────────────────────────────────────────
        {
            "scope": [
                "punctuation.separator",
                "punctuation.terminator",
                "punctuation.accessor",
                "punctuation.definition.block",
                "punctuation.definition.parameters",
                "punctuation.definition.arguments",
                "punctuation.section",
                "meta.brace",
                "punctuation.bracket"
            ],
            "settings": {
                "foreground": "#DCDCDC"
            }
        },
        // ── Strings ─────────────────────────────────────────────
        {
            "scope": [
                "string",
                "string.quoted",
                "string.template",
                "string.interpolated",
                "meta.embedded.assembly"
            ],
            "settings": {
                "foreground": "#D69D85"
            }
        },
        {
            "scope": [
                "string.regexp"
            ],
            "settings": {
                "foreground": "#D16969"
            }
        },
        {
            "scope": [
                "constant.character.escape",
                "string.template punctuation.definition.template-expression"
            ],
            "settings": {
                "foreground": "#D7BA7D"
            }
        },
        // ── Template expression (interpolation) ─────────────────
        {
            "scope": [
                "punctuation.definition.template-expression.begin",
                "punctuation.definition.template-expression.end",
                "punctuation.section.embedded"
            ],
            "settings": {
                "foreground": "#569CD6"
            }
        },
        // ── Numbers ─────────────────────────────────────────────
        {
            "scope": [
                "constant.numeric",
                "constant.numeric.integer",
                "constant.numeric.float",
                "constant.numeric.hex",
                "constant.numeric.octal",
                "constant.numeric.binary"
            ],
            "settings": {
                "foreground": "#B5CEA8"
            }
        },
        // ── Constants ───────────────────────────────────────────
        {
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined",
                "variable.language.this",
                "variable.language.self",
                "variable.language.super"
            ],
            "settings": {
                "foreground": "#569CD6"
            }
        },
        {
            "scope": [
                "constant.regexp"
            ],
            "settings": {
                "foreground": "#646695"
            }
        },
        // ── Functions ───────────────────────────────────────────
        {
            "scope": [
                "entity.name.function",
                "support.function",
                "meta.function-call entity.name.function",
                "meta.method-call entity.name.function"
            ],
            "settings": {
                "foreground": "#DCDCAA"
            }
        },
        // ── Classes / Types ─────────────────────────────────────
        {
            "scope": [
                "entity.name.type",
                "entity.name.type.class",
                "entity.name.type.enum",
                "support.type",
                "support.class",
                "entity.other.inherited-class"
            ],
            "settings": {
                "foreground": "#4EC9B0"
            }
        },
        // ── Struct names — distinct green in VS IDE ─────────────
        {
            "scope": [
                "entity.name.type.struct"
            ],
            "settings": {
                "foreground": "#86C691"
            }
        },
        // ── Interface names — light green in VS IDE ─────────────
        {
            "scope": [
                "entity.name.type.interface"
            ],
            "settings": {
                "foreground": "#B8D7A3"
            }
        },
        // ── Type Parameters ─────────────────────────────────────
        {
            "scope": [
                "entity.name.type.parameter",
                "entity.name.type.type-parameter"
            ],
            "settings": {
                "foreground": "#B8D7A3"
            }
        },
        // ── Variables / Parameters ───────────────────────────────
        {
            "scope": [
                "variable",
                "variable.other",
                "variable.parameter",
                "meta.parameter"
            ],
            "settings": {
                "foreground": "#9CDCFE"
            }
        },
        // ── Properties / Fields — white (Identifier) in VS IDE ──
        {
            "scope": [
                "variable.other.property",
                "variable.other.object.property",
                "entity.name.variable.property.cs"
            ],
            "settings": {
                "foreground": "#DCDCDC"
            }
        },
        // ── JSON property keys ──────────────────────────────────
        {
            "scope": [
                "support.type.property-name",
                "support.type.property-name.json"
            ],
            "settings": {
                "foreground": "#9CDCFE"
            }
        },
        // ── Object literal keys ─────────────────────────────────
        {
            "scope": [
                "meta.object-literal.key"
            ],
            "settings": {
                "foreground": "#9CDCFE"
            }
        },
        // ── Constants (all caps / enums) ────────────────────────
        {
            "scope": [
                "variable.other.constant",
                "variable.other.enummember"
            ],
            "settings": {
                "foreground": "#4FC1FF"
            }
        },
        // ── Annotations / Decorators ────────────────────────────
        {
            "scope": [
                "meta.decorator",
                "meta.decorator entity.name.function",
                "meta.decorator punctuation.decorator",
                "storage.type.annotation",
                "punctuation.definition.annotation",
                "meta.attribute"
            ],
            "settings": {
                "foreground": "#4EC9B0"
            }
        },
        // ── Namespace / Module — white in VS IDE ────────────────
