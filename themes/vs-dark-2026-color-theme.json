        "debugToolBar.background": "#1C1C1C",
        "debugExceptionWidget.background": "#1C1C1C",
        "debugExceptionWidget.border": "#BE1100",
        "debugConsole.infoForeground": "#3794FF",
        "debugConsole.warningForeground": "#CCA700",
        "debugConsole.errorForeground": "#F14C4C",
        // ── Welcome Page ────────────────────────────────────────
        "welcomePage.background": "#1C1C1C",
        "walkThrough.embeddedEditorBackground": "#1C1C1C",
