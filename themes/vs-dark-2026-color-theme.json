    "semanticTokenColors": {
        // ── Types — VS IDE distinguishes class, struct, interface, enum ──
        "type": "#4EC9B0",
        "class": "#4EC9B0",
        "struct": "#86C691",
        "interface": "#B8D7A3",
        "enum": "#B8D7A3",
        "typeParameter": "#B8D7A3",
        // ── Namespace — white (Identifier) in VS IDE ──
        "namespace": "#DCDCDC",
        // ── Functions / Methods ──
        "function": "#DCDCAA",
        "method": "#DCDCAA",
        "function.declaration": "#DCDCAA",
        "method.declaration": "#DCDCAA",
        // ── Properties / Fields — white (Identifier) in VS IDE ──
        "property": "#DCDCDC",
        "property.static": {
            "foreground": "#DCDCDC",
            "fontStyle": "italic"
        },
        // ── Variables ──
        "variable": "#9CDCFE",
        "variable.readonly": "#9CDCFE",
        "variable.static": {
            "foreground": "#9CDCFE",
            "fontStyle": "italic"
        },
        // ── Parameters ──
        "parameter": "#9CDCFE",
        // ── Enum members — white (Identifier) in VS IDE ──
        "enumMember": "#DCDCDC",
        // ── Events — white (Identifier) in VS IDE ──
        "event": "#DCDCDC",
        // ── Keywords ──
        "keyword": "#569CD6",
        "keyword.controlFlow": "#D8A0DF",
        "controlKeyword": "#D8A0DF",
        // ── Operators ──
        "operator": "#B4B4B4",
        "newOperator": "#569CD6",
        // ── C# custom: overloaded operators use method color (Roslyn) ──
        "operatorOverloaded": "#DCDCAA",
        // ── Strings / Numbers ──
        "string": "#D69D85",
        "stringLiteral": "#D69D85",
        // ── C# custom: verbatim strings (same color as regular strings in VS) ──
        "stringVerbatim": "#D69D85",
        // ── C# custom: escape characters in strings (VS IDE default yellow) ──
        "stringEscapeCharacter": "#FFD700",
        "number": "#B5CEA8",
        "numberLiteral": "#B5CEA8",
        // ── Other ──
        "regexp": "#D16969",
        "decorator": "#4EC9B0",
        "customLiteral": "#DCDCAA",
        "macro": "#569CD6",
        "label": "#C8C8C8",
        // ── C# custom: preprocessor (Roslyn custom semantic tokens) ──
        "preprocessorKeyword": "#569CD6",
        "preprocessorText": "#DCDCDC",
        // ── C# custom: excluded/disabled code (#if false blocks) ──
        "excludedCode": "#808080",
        // ── C# custom: punctuation ──
        "punctuation": "#DCDCDC",
        // ── C# custom: delegate, extension method, record types (Roslyn) ──
        "delegate": "#4EC9B0",
        "extensionMethod": "#DCDCAA",
        "recordClass": "#4EC9B0",
        "recordStruct": "#86C691",
        "plainKeyword": "#569CD6",
        "field": "#DCDCDC",
        "local": "#9CDCFE",
        // ── C# XML Doc Comments (custom semantic tokens from Roslyn) ──
        // Green — sourced from Roslyn VisualStudio2019.xml
        "xmlDocCommentText": {
            "foreground": "#608B4E",
            "fontStyle": "italic"
        },
        "xmlDocCommentDelimiter": "#608B4E",
        "xmlDocCommentName": "#608B4E",
        "xmlDocCommentAttributeName": "#C8C8C8",
        "xmlDocCommentAttributeQuotes": "#C8C8C8",
        "xmlDocCommentAttributeValue": "#C8C8C8",
        "xmlDocCommentCDataSection": {
            "foreground": "#E9D585",
            "fontStyle": "italic"
        },
        "xmlDocCommentEntityReference": "#608B4E",
        "xmlDocCommentProcessingInstruction": "#608B4E",
        "xmlDocCommentComment": "#608B4E",
        // ── Static modifiers ──
        "function.static": {
            "foreground": "#DCDCAA",
            "fontStyle": "italic"
        },
        "method.static": {
            "foreground": "#DCDCAA",
            "fontStyle": "italic"
        }
    }
}
