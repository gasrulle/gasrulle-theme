{
    "name": "Visual Studio Dark 2026",
    "type": "dark",
    "semanticHighlighting": true,
    "colors": {
        // ── Editor ──────────────────────────────────────────────
        // Shell/UI colors sourced from VS 2026 Fluent Design System tokens
        // (see: learn.microsoft.com/en-us/visualstudio/extensibility/migration/modernize-theme-colors).
        // Syntax highlighting identical to VS 2019/2022
        // (sourced from Roslyn VisualStudio2019.xml — no updated color scheme exists).
        "editor.background": "#1C1C1C",
        "editor.foreground": "#DCDCDC",
        "editor.lineHighlightBackground": "#282828",
        "editor.lineHighlightBorder": "#282828",
