{
    "name": "Apex Pastel++",
    "type": "dark",
    "semanticHighlighting": true,
    "colors": {
        // ── Editor ──────────────────────────────────────────────
        // Rose-tinted dark background (Dusk direction) — warm rose hue ~340°
