    "tokenColors": [
        // ── General ─────────────────────────────────────────────
        {
            "scope": [
                "source",
                "text"
            ],
            "settings": {
                "foreground": "#C8C8D6"
            }
        },
        // ── Comments ────────────────────────────────────────────
        // Muted lavender-gray — pastel-matched, stays quiet
        {
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#585870",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "comment.block.documentation",
                "comment.block.javadoc"
            ],
            "settings": {
                "foreground": "#505068",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "comment.block.documentation keyword",
                "comment.block.documentation storage.type",
                "entity.name.type.instance.jsdoc",
                "keyword.other.documentation",
                "storage.type.class.jsdoc"
            ],
            "settings": {
                "foreground": "#806E64"
            }
        },
        // ── Keywords / Control ──────────────────────────────────
        // Pastel lavender — soft but distinctive signature color
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.delete",
                "keyword.operator.expression",
                "keyword.operator.instanceof",
                "keyword.operator.new",
                "keyword.operator.typeof",
                "keyword.operator.void",
                "storage",
                "storage.modifier",
                "storage.type"
            ],
            "settings": {
                "foreground": "#C298D8"
            }
        },
        // ── Control Flow — slightly brighter + italic ───────────
        // Brighter lavender for structural emphasis
        {
            "scope": [
                "keyword.control.conditional",
                "keyword.control.flow",
                "keyword.control.loop",
                "keyword.control.trycatch"
            ],
            "settings": {
                "foreground": "#D2ACEA",
                "fontStyle": "italic"
            }
        },
        // ── Operators ───────────────────────────────────────────
        {
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.assignment",
                "keyword.operator.bitwise",
                "keyword.operator.comparison",
                "keyword.operator.decrement",
                "keyword.operator.increment",
                "keyword.operator.relational",
                "keyword.operator.ternary",
                "punctuation.accessor",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": {
                "foreground": "#9C9CB8"
            }
        },
        // ── Logical / Bitwise operators — slightly brighter ─────
        {
            "scope": [
                "keyword.operator.logical",
                "keyword.operator.logical.python"
            ],
            "settings": {
                "foreground": "#98D0CC"
            }
        },
        // ── Strings ─────────────────────────────────────────────
        // Pastel mint — soft green maintaining universal convention
        {
            "scope": [
                "string",
                "string.interpolated",
                "string.quoted",
                "string.template"
            ],
            "settings": {
                "foreground": "#96CCAA"
            }
        },
        {
            "scope": [
                "constant.character.escape",
                "string.template punctuation.definition.template-expression"
            ],
            "settings": {
                "foreground": "#D8B0A0"
            }
        },
        // ── Numbers ─────────────────────────────────────────────
        // Pastel coral-peach — warm and distinct from strings
        {
            "scope": [
                "constant.numeric",
                "constant.numeric.binary",
                "constant.numeric.float",
                "constant.numeric.hex",
                "constant.numeric.integer",
                "constant.numeric.octal"
            ],
            "settings": {
                "foreground": "#D8B0A0"
            }
        },
        // ── Constants ───────────────────────────────────────────
        // Number color + italic — constant-like values
        {
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined",
                "support.constant",
                "variable.language.self",
                "variable.language.super",
                "variable.language.this"
            ],
            "settings": {
                "foreground": "#D8B0A0",
                "fontStyle": "italic"
            }
        },
        // ── Functions ───────────────────────────────────────────
        // Pastel sky blue — high readability for function/method calls
        {
            "scope": [
                "entity.name.function",
                "meta.function-call entity.name.function",
                "meta.method-call entity.name.function",
                "support.function"
            ],
            "settings": {
                "foreground": "#8CBADC"
            }
        },
        {
            "scope": [
                "entity.name.function.member",
                "meta.function-call support.function"
            ],
            "settings": {
                "foreground": "#8CBADC"
            }
        },
        // ── Classes / Types ─────────────────────────────────────
        // Pastel teal — bright and clear type anchor
        {
            "scope": [
                "entity.name.type",
                "entity.name.type.class",
                "entity.name.type.enum",
                "entity.name.type.interface",
                "entity.name.type.struct",
                "entity.other.inherited-class",
                "support.class",
                "support.type"
            ],
            "settings": {
                "foreground": "#98D0CC"
            }
        },
        // ── Type Parameters ─────────────────────────────────────
        // Desaturated teal-blue — lighter than functions, distinct from types
        {
            "scope": [
                "entity.name.type.parameter",
                "entity.name.type.type-parameter"
            ],
            "settings": {
                "foreground": "#94C8D4"
            }
        },
        // ── Variables / Parameters ───────────────────────────────
        // Foreground lavender-silver — strongest contrast for state/data
        {
            "scope": [
                "meta.parameter",
                "variable",
                "variable.other",
                "variable.parameter"
            ],
            "settings": {
                "foreground": "#C8C8D6"
            }
        },
        // ── Properties / Fields ─────────────────────────────────
        // Pastel rose — distinct from variables and functions
        {
            "scope": [
                "entity.name.tag.yaml",
                "meta.object-literal.key",
                "support.type.property-name",
                "variable.other.object.property",
                "variable.other.property"
            ],
            "settings": {
                "foreground": "#E4B0BC"
            }
        },
        // ── Constants (all caps / enums) ────────────────────────
        {
            "scope": [
                "variable.other.constant",
                "variable.other.enummember"
            ],
            "settings": {
                "foreground": "#D8B0A0",
                "fontStyle": "italic"
            }
        },
        // ── Annotations / Decorators ────────────────────────────
        // Pastel chamomile — metadata tone
        {
            "scope": [
                "meta.attribute",
                "meta.decorator",
                "meta.decorator entity.name.function",
                "meta.decorator punctuation.decorator",
                "punctuation.definition.annotation",
                "storage.type.annotation"
            ],
            "settings": {
                "foreground": "#B4B080"
            }
        },
        // ── Namespace / Module ──────────────────────────────────
        // Muted lavender — navigational, not semantic
        {
            "scope": [
                "entity.name.module",
                "entity.name.namespace",
                "entity.name.type.module",
                "entity.name.type.namespace"
            ],
            "settings": {
                "foreground": "#9898B4"
            }
        },
        // ── Punctuation ─────────────────────────────────────────
        {
            "scope": [
                "meta.brace",
                "punctuation.bracket",
                "punctuation.definition.arguments",
                "punctuation.definition.block",
                "punctuation.definition.parameters",
                "punctuation.section"
            ],
            "settings": {
                "foreground": "#9C9CB8"
            }
        },
        // ── HTML / XML Tags ─────────────────────────────────────
        // Pastel rose — warm and readable
        {
            "scope": [
                "entity.name.tag",
                "punctuation.definition.tag"
            ],
            "settings": {
                "foreground": "#E098A8"
            }
        },
        {
            "scope": [
                "entity.name.tag.custom",
