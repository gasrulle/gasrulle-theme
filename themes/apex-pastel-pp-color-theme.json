        "gitDecoration.ignoredResourceForeground": "#56414a",
        "gitDecoration.conflictingResourceForeground": "#E098A8",
        "gitDecoration.stageModifiedResourceForeground": "#8CBDC6",
        "gitDecoration.stageDeletedResourceForeground": "#716066",
        // ── Terminal ANSI Colors ────────────────────────────────
