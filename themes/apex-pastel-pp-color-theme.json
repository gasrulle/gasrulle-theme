    // ── Semantic Token Colors ───────────────────────────────────
    // Maximum C# differentiation (++) — every type category & modifier gets a unique color
    // Pastel palette: warm+cool balanced, lavender signature, ≥30° hue separation
    "semanticTokenColors": {
        // ── Types — Maximum differentiation: every category distinct ──
        "type": "#98D0CC",
        "class": "#98D0CC",
        "struct": "#9AC08C",
        "interface": "#D8B0CC",
        "enum": "#B0B8E4",
        "typeParameter": "#94C8D4",
        // ── Namespace — muted, navigational not semantic ──
        "namespace": "#9898B4",
        // ── Functions / Methods — pastel sky blue (readability) ──
        "function": "#8CBADC",
        "method": "#8CBADC",
        "function.declaration": "#8CBADC",
        "method.declaration": "#8CBADC",
        // ── Properties / Fields — pastel rose, distinct from variables ──
        "property": "#E4B0BC",
        "property.static": {
            "foreground": "#E4B0BC",
            "fontStyle": "italic"
        },
        // ── Variables — foreground lavender-silver for state/data ──
        "variable": "#C8C8D6",
        "variable.readonly": {
            "foreground": "#C8C8D6",
            "fontStyle": "italic"
        },
        "variable.static": {
            "foreground": "#C8C8D6",
            "fontStyle": "italic"
        },
        // ── Parameters — pastel chamomile, distinct from variables ──
        "parameter": "#B4B080",
        // ── Enum Members — number color italic (constant-like) ──
        "enumMember": {
            "foreground": "#D8B0A0",
            "fontStyle": "italic"
        },
        // ── Events — teal, distinct from properties ──
        "event": "#98D0CC",
        // ── Keywords — pastel lavender ──
        "keyword": "#C298D8",
        "keyword.controlFlow": {
            "foreground": "#D2ACEA",
            "fontStyle": "italic"
        },
        // ── Operators ──
        "operator": "#9C9CB8",
        "newOperator": "#C298D8",
        // ── Strings / Numbers ──
        "string": "#96CCAA",
        "stringLiteral": "#96CCAA",
        "number": "#D8B0A0",
        "numberLiteral": "#D8B0A0",
        // ── Other ──
        "regexp": "#E098A8",
        "decorator": "#B4B080",
        "customLiteral": "#D8B0A0",
        "macro": "#B4B080",
        "label": "#9C9CB8",
        // ── C# XML Doc Comments (custom semantic tokens from Roslyn) ──
        "xmlDocCommentText": {
            "foreground": "#505068",
            "fontStyle": "italic"
        },
        "xmlDocCommentDelimiter": "#505068",
        "xmlDocCommentName": "#806E64",
        "xmlDocCommentAttributeName": "#806E64",
        "xmlDocCommentAttributeQuotes": "#505068",
        "xmlDocCommentAttributeValue": "#806E64",
        "xmlDocCommentCDataSection": {
            "foreground": "#505068",
            "fontStyle": "italic"
        },
        "xmlDocCommentEntityReference": "#806E64",
        "xmlDocCommentProcessingInstruction": "#806E64",
        "xmlDocCommentComment": "#585870",
        // ── Static modifiers — italic signals static ──
        "function.static": {
            "foreground": "#8CBADC",
            "fontStyle": "italic"
        },
        "method.static": {
            "foreground": "#8CBADC",
            "fontStyle": "italic"
        }
    }
