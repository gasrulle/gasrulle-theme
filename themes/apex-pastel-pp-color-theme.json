    // ── Semantic Token Colors ───────────────────────────────────
    // Maximum C# differentiation (++) — every type category & modifier gets a unique color
    // 3-band WCAG luminance strategy:
    //   LOW band (0.30-0.31): Functions (lilac), Enums (periwinkle), Interfaces (orchid)
    //   MID band (0.46-0.50): Keywords (teal), Strings (sage), Structs (jade), Variables
    //   HIGH band (0.56-0.62): Properties (rose), Numbers (salmon), Classes (amber), Parameters (chartreuse)
    "semanticTokenColors": {
        // ── Types — Maximum differentiation: every category distinct ──
        "type": "#D5CFB5",
        "class": "#D5CFB5",
        "struct": "#8EBFAB",
        "interface": "#BB87B2",
        "enum": "#9393C5",
        "typeParameter": "#A8B4C4",
        // ── Namespace — muted, navigational not semantic ──
        "namespace": "#A09090",
        // ── Functions / Methods — pastel lilac (LOW luminance band) ──
        "function": "#AA8BC1",
        "method": "#AA8BC1",
        "function.declaration": {
            "foreground": "#AA8BC1",
            "fontStyle": "bold"
        },
        "method.declaration": {
            "foreground": "#AA8BC1",
            "fontStyle": "bold"
        },
        // ── Properties / Fields — pastel rose, distinct from variables ──
        "property": "#E2C8CF",
        "property.static": {
            "foreground": "#E2C8CF",
            "fontStyle": "italic"
        },
        // ── Variables — foreground, rose-tinted near-white for state/data ──
        "variable": "#C3B9BD",
        "variable.readonly": {
            "foreground": "#C3B9BD",
            "fontStyle": "italic"
        },
        "variable.static": {
            "foreground": "#C3B9BD",
            "fontStyle": "italic"
        },
        // ── Parameters — pastel chartreuse, distinct from variables ──
        "parameter": "#C7D3B3",
        // ── Enum Members — salmon italic (constant-like) ──
        "enumMember": {
            "foreground": "#DECBC4",
            "fontStyle": "italic"
        },
        // ── Events — amber, distinct from properties ──
        "event": "#D5CFB5",
        // ── Keywords — pastel teal (signature color) ──
        "keyword": "#8CBDC6",
        "keyword.controlFlow": {
            "foreground": "#ABCBD2",
            "fontStyle": "italic"
        },
        // ── C# custom: Roslyn emits controlKeyword as a separate token type ──
        "controlKeyword": {
            "foreground": "#ABCBD2",
            "fontStyle": "italic"
        },
        // ── Operators ──
        "operator": "#A89CA0",
        "newOperator": "#8CBDC6",
        // ── C# custom: overloaded operators use function color ──
        "operatorOverloaded": "#AA8BC1",
        // ── Strings / Numbers ──
        "string": "#97BF93",
        "stringLiteral": "#97BF93",
        // ── C# custom: verbatim strings ──
        "stringVerbatim": "#97BF93",
        // ── C# custom: escape characters — keyword color ──
        "stringEscapeCharacter": "#8CBDC6",
        "number": "#DECBC4",
        "numberLiteral": "#DECBC4",
        // ── Other ──
        "regexp": "#E098A8",
        "decorator": "#C7D3B3",
        "customLiteral": "#DECBC4",
        "macro": "#C7D3B3",
        "label": "#A89CA0",
        // ── C# custom: preprocessor ──
        "preprocessorKeyword": "#8CBDC6",
        "preprocessorText": "#C3B9BD",
        // ── C# custom: excluded/disabled code ──
        "excludedCode": "#808080",
        // ── C# custom: punctuation ──
        "punctuation": "#A89CA0",
        // ── C# custom: delegate, extension method, record types ──
        "delegate": "#D5CFB5",
        "extensionMethod": "#AA8BC1",
        "recordClass": "#D5CFB5",
        "recordStruct": "#8EBFAB",
        "plainKeyword": "#8CBDC6",
        "field": "#E2C8CF",
        "local": "#C3B9BD",
        // ── C# XML Doc Comments (custom semantic tokens from Roslyn) ──
        "xmlDocCommentText": {
            "foreground": "#62565a",
            "fontStyle": "italic"
        },
        "xmlDocCommentDelimiter": "#62565a",
        "xmlDocCommentName": "#746458",
        "xmlDocCommentAttributeName": "#746458",
        "xmlDocCommentAttributeQuotes": "#62565a",
        "xmlDocCommentAttributeValue": "#746458",
        "xmlDocCommentCDataSection": {
            "foreground": "#62565a",
            "fontStyle": "italic"
        },
        "xmlDocCommentEntityReference": "#746458",
        "xmlDocCommentProcessingInstruction": "#746458",
        "xmlDocCommentComment": "#716066",
        // ── Static modifiers — italic signals static ──
        "function.static": {
            "foreground": "#AA8BC1",
            "fontStyle": "italic"
        },
        "method.static": {
            "foreground": "#AA8BC1",
            "fontStyle": "italic"
        }
    }
}
