    // ── Semantic Token Colors ───────────────────────────────────
    // Maximum C# differentiation (++) — every type category & modifier gets a unique color
    // Design principles from research synthesis:
    //   - Night Owl: blue for readability, contrast hierarchy, white for data
    //   - Catppuccin: warm pastels, harmonic balance
    //   - Tokyo Night: sophisticated semantic token scoping
    //   - One Dark Pro: clean C# type/variable distinction
    //   - VS Dark: maximum type differentiation (struct≠class≠interface≠enum)
    "semanticTokenColors": {
        // ── Types — Maximum differentiation: every category distinct ──
        "type": "#81c8be",
        "class": "#81c8be",
        "struct": "#a6d9a6",
        "interface": "#b4befe",
        "enum": "#eebebe",
        "typeParameter": "#99d1db",
        // ── Namespace — muted, navigational not semantic ──
        "namespace": "#9399b2",
        // ── Functions / Methods — warm blue (reading comprehension) ──
        "function": "#8caaee",
        "method": "#8caaee",
        "function.declaration": "#8caaee",
        "method.declaration": "#8caaee",
        // ── Properties / Fields — pink/rose, distinct from variables ──
        "property": "#f4b8e4",
        "property.static": {
            "foreground": "#f4b8e4",
            "fontStyle": "italic"
        },
        // ── Variables — foreground, Night Owl: white for state/data ──
        "variable": "#c8cee0",
        "variable.readonly": {
            "foreground": "#c8cee0",
            "fontStyle": "italic"
        },
        "variable.static": {
            "foreground": "#c8cee0",
            "fontStyle": "italic"
        },
        // ── Parameters — warm amber, distinct from variables ──
        "parameter": "#e5c890",
        // ── Enum Members — number color italic (constant-like) ──
        "enumMember": {
            "foreground": "#f2b07a",
            "fontStyle": "italic"
        },
        // ── Events — teal, distinct from properties ──
        "event": "#81c8be",
        // ── Keywords — warm purple ──
        "keyword": "#c9a0f5",
        "keyword.controlFlow": {
            "foreground": "#d8b0f8",
            "fontStyle": "italic"
        },
        // ── Operators ──
        "operator": "#9aa2c0",
        "newOperator": "#c9a0f5",
        // ── Strings / Numbers ──
        "string": "#a6d189",
        "stringLiteral": "#a6d189",
        "number": "#f2b07a",
        "numberLiteral": "#f2b07a",
        // ── Other ──
        "regexp": "#f38ba8",
        "decorator": "#e5c890",
        "customLiteral": "#f2b07a",
        "macro": "#e5c890",
        "label": "#9aa2c0",
        // ── C# XML Doc Comments (custom semantic tokens from Roslyn) ──
        "xmlDocCommentText": {
            "foreground": "#5E6270",
            "fontStyle": "italic"
        },
        "xmlDocCommentDelimiter": "#5E6270",
        "xmlDocCommentName": "#A8907E",
        "xmlDocCommentAttributeName": "#A8907E",
        "xmlDocCommentAttributeQuotes": "#5E6270",
        "xmlDocCommentAttributeValue": "#A8907E",
        "xmlDocCommentCDataSection": {
            "foreground": "#5E6270",
            "fontStyle": "italic"
        },
        "xmlDocCommentEntityReference": "#A8907E",
        "xmlDocCommentProcessingInstruction": "#A8907E",
        "xmlDocCommentComment": "#6c7086",
        // ── Static modifiers — italic signals static ──
        "function.static": {
            "foreground": "#8caaee",
            "fontStyle": "italic"
        },
        "method.static": {
            "foreground": "#8caaee",
            "fontStyle": "italic"
        }
    }
}

