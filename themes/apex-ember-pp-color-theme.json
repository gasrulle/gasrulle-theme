    "tokenColors": [
        // ── General ─────────────────────────────────────────────
        {
            "scope": [
                "source",
                "text"
            ],
            "settings": {
                "foreground": "#c8cee0"
            }
        },
        // ── Comments ────────────────────────────────────────────
        // Warm muted gray — Catppuccin overlay0 territory
        // Night Owl: "if everything is important, nothing is" — comments stay quiet
        {
            "scope": [
                "comment",
                "punctuation.definition.comment"
            ],
            "settings": {
                "foreground": "#6c7086",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "comment.block.documentation",
                "comment.block.javadoc"
            ],
            "settings": {
                "foreground": "#5E6270",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "comment.block.documentation keyword",
                "comment.block.documentation storage.type",
                "entity.name.type.instance.jsdoc",
                "keyword.other.documentation",
                "storage.type.class.jsdoc"
            ],
            "settings": {
                "foreground": "#A8907E"
            }
        },
        // ── Keywords / Control ──────────────────────────────────
        // Warm purple — Catppuccin mauve meets One Dark purple
        // Night Owl research: purple for keywords (complementary color, good across colorblindness)
        {
            "scope": [
                "keyword",
                "keyword.control",
                "keyword.operator.delete",
                "keyword.operator.expression",
                "keyword.operator.instanceof",
                "keyword.operator.new",
                "keyword.operator.typeof",
                "keyword.operator.void",
                "storage",
                "storage.modifier",
                "storage.type"
            ],
            "settings": {
                "foreground": "#c9a0f5"
            }
        },
        // ── Control Flow — slightly brighter + italic ───────────
        // Night Owl: control flow is structural, deserves subtle emphasis
        {
            "scope": [
                "keyword.control.conditional",
                "keyword.control.flow",
                "keyword.control.loop",
                "keyword.control.trycatch"
            ],
            "settings": {
                "foreground": "#d8b0f8",
                "fontStyle": "italic"
            }
        },
        // ── Operators ───────────────────────────────────────────
        {
            "scope": [
                "keyword.operator",
                "keyword.operator.arithmetic",
                "keyword.operator.assignment",
                "keyword.operator.bitwise",
                "keyword.operator.comparison",
                "keyword.operator.decrement",
                "keyword.operator.increment",
                "keyword.operator.relational",
                "keyword.operator.ternary",
                "punctuation.accessor",
                "punctuation.separator",
                "punctuation.terminator"
            ],
            "settings": {
                "foreground": "#9aa2c0"
            }
        },
        // ── Logical / Bitwise operators — slightly brighter ─────
        {
            "scope": [
                "keyword.operator.logical",
                "keyword.operator.logical.python"
            ],
            "settings": {
                "foreground": "#81c8be"
            }
        },
        // ── Strings ─────────────────────────────────────────────
        // Warm green pastel — between Catppuccin green (#a6e3a1) and One Dark (#98c379)
        {
            "scope": [
                "string",
                "string.interpolated",
                "string.quoted",
                "string.template"
            ],
            "settings": {
                "foreground": "#a6d189"
            }
        },
        {
            "scope": [
                "constant.character.escape",
                "string.template punctuation.definition.template-expression"
            ],
            "settings": {
                "foreground": "#f2b07a"
            }
        },
        // ── Numbers ─────────────────────────────────────────────
        // Peach/amber — warm and distinct from strings
        {
            "scope": [
                "constant.numeric",
                "constant.numeric.binary",
                "constant.numeric.float",
                "constant.numeric.hex",
                "constant.numeric.integer",
                "constant.numeric.octal"
            ],
            "settings": {
                "foreground": "#f2b07a"
            }
        },
        // ── Constants ───────────────────────────────────────────
        // Same purple family as keywords — language constants are keyword-like
        {
            "scope": [
                "constant.language",
                "constant.language.boolean",
                "constant.language.null",
                "constant.language.undefined",
                "support.constant",
                "variable.language.self",
                "variable.language.super",
                "variable.language.this"
            ],
            "settings": {
                "foreground": "#f2b07a",
                "fontStyle": "italic"
            }
        },
        // ── Functions ───────────────────────────────────────────
        // Warm blue — Night Owl research: blue strongest for reading comprehension
        {
            "scope": [
                "entity.name.function",
                "meta.function-call entity.name.function",
                "meta.method-call entity.name.function",
                "support.function"
            ],
            "settings": {
                "foreground": "#8caaee"
            }
        },
        {
            "scope": [
                "entity.name.function.member",
                "meta.function-call support.function"
            ],
            "settings": {
                "foreground": "#8caaee"
            }
        },
        // ── Classes / Types ─────────────────────────────────────
        // Teal — warm take on the VS Code type color tradition
        {
            "scope": [
                "entity.name.type",
                "entity.name.type.class",
                "entity.name.type.enum",
                "entity.name.type.interface",
                "entity.name.type.struct",
                "entity.other.inherited-class",
                "support.class",
                "support.type"
            ],
            "settings": {
                "foreground": "#81c8be"
            }
        },
        // ── Type Parameters ─────────────────────────────────────
        // Sky blue — lighter than functions, distinct from types
        {
            "scope": [
                "entity.name.type.parameter",
                "entity.name.type.type-parameter"
            ],
            "settings": {
                "foreground": "#99d1db"
            }
        },
        // ── Variables / Parameters ───────────────────────────────
        // Night Owl: white for state/data — strongest contrast for what you read most
        {
            "scope": [
                "meta.parameter",
                "variable",
                "variable.other",
                "variable.parameter"
            ],
            "settings": {
                "foreground": "#c8cee0"
            }
        },
        // ── Properties / Fields ─────────────────────────────────
        // Pink/rose — distinct from variables, Catppuccin pink family
        {
            "scope": [
                "entity.name.tag.yaml",
                "meta.object-literal.key",
                "support.type.property-name",
                "variable.other.object.property",
                "variable.other.property"
            ],
            "settings": {
                "foreground": "#f4b8e4"
            }
        },
        // ── Constants (all caps / enums) ────────────────────────
        {
            "scope": [
                "variable.other.constant",
                "variable.other.enummember"
            ],
            "settings": {
                "foreground": "#f2b07a",
                "fontStyle": "italic"
            }
        },
        // ── Annotations / Decorators ────────────────────────────
        // Amber — metadata tone, matches parameter warmth
        {
            "scope": [
                "meta.attribute",
                "meta.decorator",
                "meta.decorator entity.name.function",
                "meta.decorator punctuation.decorator",
                "punctuation.definition.annotation",
                "storage.type.annotation"
            ],
            "settings": {
                "foreground": "#e5c890"
            }
        },
        // ── Namespace / Module ──────────────────────────────────
        // Muted subtext — namespaces are navigational, not semantic
        {
            "scope": [
                "entity.name.module",
                "entity.name.namespace",
                "entity.name.type.module",
                "entity.name.type.namespace"
            ],
            "settings": {
                "foreground": "#9399b2"
            }
        },
        // ── Punctuation ─────────────────────────────────────────
        {
            "scope": [
                "meta.brace",
                "punctuation.bracket",
                "punctuation.definition.arguments",
                "punctuation.definition.block",
                "punctuation.definition.parameters",
