    "semanticTokenColors": {
        "namespace": "#BCBEC4",
        "type": "#6FAFBD",
        "class": "#6FAFBD",
        "struct": "#6FAFBD",
        "interface": "#6FAFBD",
        "enum": "#6FAFBD",
        "typeParameter": "#16BAAC",
        "function": "#56A8F5",
        "method": "#57AAF7",
        "property": "#C77DBB",
        "variable": "#BCBEC4",
        "variable.readonly": {
            "foreground": "#C77DBB",
            "fontStyle": "italic"
        },
        "enumMember": {
            "foreground": "#C77DBB",
            "fontStyle": "italic"
        },
        "parameter": "#BCBEC4",
        "keyword": "#CF8E6D",
        "newOperator": "#CF8E6D",
        // ── C# custom: Roslyn emits controlKeyword as a separate token type ──
        "controlKeyword": "#CF8E6D",
        "string": "#6AAB73",
        // ── C# custom: verbatim strings (same as regular strings in Rider) ──
        "stringVerbatim": "#6AAB73",
