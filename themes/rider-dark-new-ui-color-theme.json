            "settings": {
                "foreground": "#CF8E6D"
            }
        },
        {
            "scope": [
                "entity.name.tag.css"
            ],
            "settings": {
                "foreground": "#D5B778"
            }
        },
        {
            "scope": [
                "keyword.other.unit.css"
